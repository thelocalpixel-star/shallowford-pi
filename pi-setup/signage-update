#!/bin/sh
# Download the signage content from GitHub and deploy it.
# The display mode persists across updates: the download refreshes all
# content files, but which page goes live follows /etc/default/signage-mode,
# so the 8am update can never clobber an active takeover.
set -eu

archive_url=${SIGNAGE_ARCHIVE_URL:-https://codeload.github.com/thelocalpixel-star/shallowford-pi/tar.gz/refs/heads/main}
work_dir=$(mktemp -d /tmp/signage-update.XXXXXX)
trap 'rm -rf "$work_dir"' EXIT HUP INT TERM

echo "Downloading signage from GitHub..."
curl \
  --fail \
  --location \
  --silent \
  --show-error \
  --connect-timeout 20 \
  --max-time 600 \
  --retry 3 \
  --retry-delay 10 \
  --retry-all-errors \
  --output "$work_dir/signage.tar.gz" \
  "$archive_url"

mkdir "$work_dir/extracted"
tar -xzf "$work_dir/signage.tar.gz" \
  -C "$work_dir/extracted" \
  --strip-components=1

mode=normal
if [ -f /etc/default/signage-mode ]; then
  # shellcheck disable=SC1091
  . /etc/default/signage-mode
  mode=${MODE:-normal}
fi

if [ "$mode" = "takeover" ]; then
  page="$work_dir/extracted/takeover.html"
  source_name="github-main-takeover"
else
  page="$work_dir/extracted/index.html"
  source_name="github-main"
fi

/usr/local/sbin/signage-deploy-files "$page" "$work_dir/extracted/ad.mp4" "$source_name"

echo "GitHub signage update completed successfully (mode=$mode)."

#!/bin/sh
# Install a signage release under /home/admin/signage/releases/<id>.
# The given HTML is installed as index.html (the page the kiosk loads) and
# the given MP4 as ad.mp4. Companion files found next to the HTML source
# (normal ad page, takeover page, takeover image) ride along into every
# release, so any release can serve either display mode and the scheduled
# updater never drops the takeover image.
set -eu

SIGNAGE_ROOT=/home/admin/signage

if [ "$(id -u)" -ne 0 ]; then
  echo "Run this command with sudo." >&2
  exit 1
fi

if [ "$#" -lt 2 ] || [ "$#" -gt 3 ]; then
  echo "Usage: signage-deploy-files INDEX_HTML AD_MP4 [SOURCE]" >&2
  exit 2
fi

html_file=$1
video_file=$2
source_name=${3:-manual}
src_dir=$(dirname "$html_file")

if [ ! -s "$html_file" ]; then
  echo "HTML file is missing or empty: $html_file" >&2
  exit 1
fi

if [ ! -s "$video_file" ]; then
  echo "MP4 file is missing or empty: $video_file" >&2
  exit 1
fi

if ! grep -Eqi '<!doctype|<html' "$html_file"; then
  echo "HTML validation failed: $html_file" >&2
  exit 1
fi

video_type=$(file -b "$video_file")
case "$video_type" in
  *ISO\ Media*|*MPEG*|*MP4*) ;;
  *)
    echo "MP4 validation failed: $video_type" >&2
    exit 1
    ;;
esac

# Companion files ride along when present next to the HTML source.
# The repository's index.html is the normal ad; it is stored as normal.html
# for mode switches, unless it is the page being deployed right now.
takeover_html=""
takeover_png=""
normal_html=""
[ -s "$src_dir/takeover.html" ] && takeover_html="$src_dir/takeover.html"
[ -s "$src_dir/takeover.png" ] && takeover_png="$src_dir/takeover.png"
if [ -s "$src_dir/index.html" ] && [ "$src_dir/index.html" != "$html_file" ]; then
  normal_html="$src_dir/index.html"
fi

hash_input=$(mktemp)
trap 'rm -f "$hash_input"' EXIT HUP INT TERM
cat "$html_file" "$video_file" > "$hash_input"
[ -n "$takeover_html" ] && cat "$takeover_html" >> "$hash_input"
[ -n "$takeover_png" ] && cat "$takeover_png" >> "$hash_input"
[ -n "$normal_html" ] && cat "$normal_html" >> "$hash_input"
release_id=$(sha256sum "$hash_input" | cut -c1-16)
rm -f "$hash_input"
trap - EXIT HUP INT TERM

release_dir="$SIGNAGE_ROOT/releases/$release_id"
release_target="releases/$release_id"

install -d -o admin -g admin "$SIGNAGE_ROOT/releases"

if [ ! -d "$release_dir" ]; then
  temp_release="$SIGNAGE_ROOT/releases/.$release_id.$$"
  trap 'rm -rf "$temp_release"' EXIT HUP INT TERM
  install -d -o admin -g admin "$temp_release"
  install -m 0644 -o admin -g admin "$html_file" "$temp_release/index.html"
  install -m 0644 -o admin -g admin "$video_file" "$temp_release/ad.mp4"
  [ -n "$takeover_html" ] && install -m 0644 -o admin -g admin "$takeover_html" "$temp_release/takeover.html"
  [ -n "$takeover_png" ] && install -m 0644 -o admin -g admin "$takeover_png" "$temp_release/takeover.png"
  [ -n "$normal_html" ] && install -m 0644 -o admin -g admin "$normal_html" "$temp_release/normal.html"
  html_hash=$(sha256sum "$html_file" | cut -d' ' -f1)
  video_hash=$(sha256sum "$video_file" | cut -d' ' -f1)
  {
    echo "source=$source_name"
    echo "installed=$(date --iso-8601=seconds)"
    echo "html_sha256=$html_hash"
    echo "video_sha256=$video_hash"
  } > "$temp_release/release-info.txt"
  chown admin:admin "$temp_release/release-info.txt"
  chmod 0644 "$temp_release/release-info.txt"
  mv "$temp_release" "$release_dir"
  trap - EXIT HUP INT TERM
fi

current_target=$(readlink "$SIGNAGE_ROOT/current" 2>/dev/null || true)
if [ "$current_target" = "$release_target" ]; then
  echo "Signage is already current: $release_id"
  exit 0
fi

next_link="$SIGNAGE_ROOT/.current.$$"
ln -s "$release_target" "$next_link"
mv -Tf "$next_link" "$SIGNAGE_ROOT/current"
chown -h admin:admin "$SIGNAGE_ROOT/current"

echo "Activated signage release: $release_id ($source_name)"

if systemctl is-active --quiet getty@tty1.service; then
  systemctl restart getty@tty1.service
fi
